<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Databases are encrypted with keys that are never backed up, so a copy could never be opened. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
