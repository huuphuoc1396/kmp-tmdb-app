CREATE TABLE favorite (
    tmdbId INTEGER NOT NULL,
    type TEXT NOT NULL,
    addedAt INTEGER NOT NULL,
    PRIMARY KEY (tmdbId, type)
);

isFavorite:
SELECT EXISTS(SELECT 1 FROM favorite WHERE tmdbId = ? AND type = ?);

selectAllNewestFirst:
SELECT tmdbId, type FROM favorite ORDER BY addedAt DESC, tmdbId DESC, type DESC;

selectAddedAt:
SELECT addedAt FROM favorite WHERE tmdbId = ? AND type = ?;

insert:
INSERT OR IGNORE INTO favorite (tmdbId, type, addedAt) VALUES (?, ?, ?);

delete:
DELETE FROM favorite WHERE tmdbId = ? AND type = ?;
