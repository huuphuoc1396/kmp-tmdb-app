CREATE TABLE titleListItem (
    list TEXT NOT NULL,
    language TEXT NOT NULL,
    position INTEGER NOT NULL,
    tmdbId INTEGER NOT NULL,
    type TEXT NOT NULL,
    name TEXT NOT NULL,
    posterPath TEXT,
    PRIMARY KEY (list, language, position)
);

CREATE TABLE titleListFetch (
    list TEXT NOT NULL,
    language TEXT NOT NULL,
    fetchedAt INTEGER NOT NULL,
    PRIMARY KEY (list, language)
);

selectTitles:
SELECT tmdbId, type, name, posterPath
FROM titleListItem
WHERE list = ? AND language = ?
ORDER BY position;

selectFetchedAt:
SELECT fetchedAt
FROM titleListFetch
WHERE list = ? AND language = ?;

deleteTitles:
DELETE FROM titleListItem
WHERE list = ? AND language = ?;

insertTitle:
INSERT INTO titleListItem (list, language, position, tmdbId, type, name, posterPath)
VALUES (?, ?, ?, ?, ?, ?, ?);

upsertFetchedAt:
INSERT OR REPLACE INTO titleListFetch (list, language, fetchedAt)
VALUES (?, ?, ?);
